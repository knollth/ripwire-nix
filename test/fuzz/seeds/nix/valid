{
  description = "a flake that exercises the shapes the grammar handles";
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs = { self, nixpkgs }: {
    lib.mkTitle = prefix: text: "${prefix} — ${text}";
    packages.x86_64-linux.default =
      nixpkgs.legacyPackages.x86_64-linux.stdenv.mkDerivation {
        pname = "seed"; version = "0.1.0"; src = ./.;
        doCheck = true;
        checkPhase = ''
          runHook preCheck
          echo "checking ''${pname}-''${version}"
          runHook postCheck
        '';
      };
  };
}
